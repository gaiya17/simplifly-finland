simpliflyfinland.fi, www.simpliflyfinland.fi {
    # ── 301 Permanent Redirect to preserve SEO ──────────────────────────
    redir https://simpliflyfinland.com{uri} 301
}

simpliflyfinland.com, www.simpliflyfinland.com {
    # ── Automatic HTTPS via Let's Encrypt ───────────────────────────────
    # Caddy handles cert issuance and renewal automatically. No certbot needed.

    # ── Reverse proxy to Next.js frontend ───────────────────────────────
    reverse_proxy frontend:3000

    # ── Static asset caching ────────────────────────────────────────────
    # Next.js fingerprints all static assets with a hash in the filename,
    # so it's safe to cache them for 1 year. This drastically speeds up
    # repeat visits — browser loads assets from cache, not the server.
    @static {
        path /_next/static/* /favicon.ico /images/* /fonts/* *.svg *.png *.jpg *.webp *.avif *.ico *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # ── Security Headers ────────────────────────────────────────────────
    header {
        # Enforce HTTPS for 1 year (including subdomains). Browsers will
        # refuse plain HTTP connections after the first visit.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Block the site from being embedded in iframes (clickjacking protection)
        X-Frame-Options "DENY"

        # Prevent browsers from MIME-sniffing responses away from declared content-type
        X-Content-Type-Options "nosniff"

        # Only send the origin (no path) in the Referer header when navigating away
        Referrer-Policy "strict-origin-when-cross-origin"

        # Disable access to camera, mic, geolocation, USB by default
        Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"

        # Remove the Caddy server version header (don't advertise software version)
        -Server
    }

    # ── Compression ─────────────────────────────────────────────────────
    encode zstd gzip
}

api.simpliflyfinland.com {
    # ── Automatic HTTPS via Let's Encrypt ───────────────────────────────
    reverse_proxy backend:5000

    # ── Security Headers for the API ────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    encode zstd gzip
}
